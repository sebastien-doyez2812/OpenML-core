@startuml
class BaseModel {
  - name : str
  + __init__() : void
  + help() : void
  + train() : void
  + predict() : void
  + evaluate() : void
  + get_model_info() : dict
  + save_model(path: str) : void
}

class Unet {
  - depth : int
  - input_size : tuple
  - attention_unet : bool
  - deep_supervision : bool
  + forward(x) : Tensor
}


class UnetPP {
  - input_channels : int =1
  - output_channels : int =1
  - depth : int =4
  - initial_filters : int =64
  + forward(X) : Tensor
}

class AttentionUnet {
  - input_channels: int =1
  - output_channels: int =1
  - depth: int =4
  - initial_filters: int =64
  + forward(X): Tensor
}

class SegFormer  {
  - input_channels: int =1
  - output_channels: int =1
  - depth: int =4
  - initial_filters: int =64
  - H, W: int = 256
  + forward(X): Tensor
}

class MobileUnetR {
  - input_channels: int = 1
  - output_channels: int = 1
  + forward(X): Tensor
}

Unet          --|> BaseModel : heritage
UnetPP        --|> BaseModel : heritage
AttentionUnet --|> BaseModel : heritage
SegFormer     --|> BaseModel : heritage
MobileUnetR   --|> BaseModel : heritage
@enduml